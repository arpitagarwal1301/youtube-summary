{
  "manifest_version": 3,
  "name": "Know It for YouTube",
  "version": "1.2.1",
  "description": "Get the answer to a YouTube headline without opening the video.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "offscreen",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Know It: time left, today's answers and settings",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "setup.html",
        "setup.js",
        "panel.html",
        "panel.js",
        "panel.css"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
