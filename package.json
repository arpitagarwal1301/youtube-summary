{
  "name": "know-it-youtube",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that answers a YouTube headline without opening the video.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "test:real": "node e2e/real-gemini.mjs",
    "try-videos": "node scripts/try-videos.mjs",
    "package": "npm run build && rm -f know-it.zip && cd dist && zip -qr ../know-it.zip . -x '.*'",
    "store-screenshots": "node scripts/store-screenshots.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
